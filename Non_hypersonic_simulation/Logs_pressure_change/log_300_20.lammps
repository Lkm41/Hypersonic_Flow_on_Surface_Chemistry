
units                   metal #Changed from real to metal
dimension               3
boundary                p p f #changed from p p p to p p f
atom_style              full
#--------------------------------------------------------------------------------

# Variables
variable                Nsteps equal 100000
variable                dt equal 5.0
variable                seed equal 20000 #12345 # random number seed
#--------------------------------------------------------------------------------

# creating simulation box
read_data               data.Ti extra/bond/types 1 extra/bond/per/atom 2
Reading data file ...
  orthogonal box = (0 0 0) to (100 100 800)
  2 by 1 by 12 MPI processor grid
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.001 seconds
  read_data CPU = 0.004 seconds

#change_box all z final 0 ${Lz} units box #for only change in Lz
change_box              all x final 0 ${Lx} y final 0 ${Ly} z final 0 ${Lz} units box #for change in Lz, Lx, and Ly
change_box              all x final 0 38.35 y final 0 ${Ly} z final 0 ${Lz} units box 
change_box              all x final 0 38.35 y final 0 38.35 z final 0 ${Lz} units box 
change_box              all x final 0 38.35 y final 0 38.35 z final 0 77.87310102154218 units box 
Changing box ...
  orthogonal box = (0 0 0) to (38.35 100 800)
  orthogonal box = (0 0 0) to (38.35 38.35 800)
  orthogonal box = (0 0 0) to (38.35 38.35 77.873101)

timestep                0.001

neighbor                1.5 bin
#-----------------------------------------------------------------------------------

#defining Ti region
group                   titanium type 1
0 atoms in group titanium

region                  Ti_zone block INF INF INF INF INF 16 units box
#changed from 8
region                  bottom block INF INF INF INF INF 4 units box #Ti bottom layer region

region                  middle block INF INF INF INF 4 8 units box #Ti middle layer

region                  upper block INF INF INF INF 8 16 units box #Ti upper layer region

#---------------------------------------------------------------------------------------------
#obseration regions
region                  obs_Ti block INF INF INF INF 8 16 units box #observation region - to observe temperature of moving Ti layer
#changed from 3 8

region                  obs block INF INF INF INF 16 19 units box #observation region - for physisorption effect
#changed from 8 11

region                  obs_O2 block INF INF INF INF 19 INF units box #observation region - for gas temperature
#changed from 11
#-------------------------------------------------------------------------------

#lennard-jones
pair_style              hybrid lj/cut 15.0 eam/fs #changed from 15 to 10

pair_coeff              * * eam/fs Ti1.eam.fs Ti NULL #Ti-Ti
pair_coeff              2 2 lj/cut 0.0044640704 3.00578 #O-O #taken from: file://ifs.eng.cam.ac.uk/users/lkm41/Downloads/Short-Time_Oxidation_Behavior_of_Low-Carbon_Low-Si.pdf
pair_coeff              1 2 lj/cut 0.0105961 2.60289 #Ti-O #mixing lennard jones potential

# O2 Bonds
bond_style              harmonic
bond_coeff              1 847.0 1.21

special_bonds           lj 0.0 0.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.001 seconds

#creating atoms for Ti_zone
lattice                 hcp 2.95
Lattice spacing in x,y,z = 2.95 5.1095499 4.8173298
create_atoms            1 region Ti_zone
Created 1417 atoms
  using lattice units in orthogonal box = (0 0 0) to (38.35 38.35 77.873101)
  create_atoms CPU = 0.006 seconds

#---------------------------------------------------------------------------------------
#Ti_zone groups
group                   bottom region bottom
403 atoms in group bottom
group                   middle region middle
403 atoms in group middle
group                   upper region upper
611 atoms in group upper
#-------------------------------------------------------------------------------------

#creating O2 molecules
molecule                O2 O2.txt #made from given file
Read molecule template O2:
# O2 molecule
  1 molecules
  0 fragments
  0 bodies
  2 atoms with max type 1
  1 bonds with max type 1
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0

region                  gas block INF INF INF INF 19.0 ${Lz_minus_one} units box #gas region above  Ti slab
region                  gas block INF INF INF INF 19.0 76.87310102154218 units box 


create_atoms            1 random ${N} ${seed} gas mol O2 ${seed} units box
create_atoms            1 random 55 ${seed} gas mol O2 ${seed} units box
create_atoms            1 random 55 20000 gas mol O2 ${seed} units box
create_atoms            1 random 55 20000 gas mol O2 20000 units box
Created 110 atoms
  using box units in orthogonal box = (0 0 0) to (38.35 38.35 77.873101)
  create_atoms CPU = 0.000 seconds
group                   O2_zone region gas
110 atoms in group O2_zone

group                   mobile subtract all bottom middle
721 atoms in group mobile

fix                     freeze bottom setforce 0.0 0.0 0.0

fix                     balance all balance 5000 1.1 shift xyz 5 1.05

#obervation group for physisorption
group                   obs dynamic all region obs every 1000
dynamic group obs defined
#obervation group for titanium layer
group                   obs_Ti dynamic all region obs_Ti every 1000
dynamic group obs_Ti defined

#----------------------------------------------------------------------------------------------------------------------
#observation for pressure

variable                zhi equal ${Lz}
variable                zhi equal 77.87310102154218
variable                zlo equal ${Lz}-200
variable                zlo equal 77.87310102154218-200

region                  gas_obs_zone block INF INF INF INF ${zlo} ${zhi} units box
region                  gas_obs_zone block INF INF INF INF -122.126898978458 ${zhi} units box
region                  gas_obs_zone block INF INF INF INF -122.126898978458 77.8731010215422 units box

group                   O2_in_obs_zone dynamic all region gas_obs_zone every 100
dynamic group O2_in_obs_zone defined

variable                O2_obs_zone_volume equal lx*ly*(${zhi}-${zlo})
variable                O2_obs_zone_volume equal lx*ly*(77.8731010215422-${zlo})
variable                O2_obs_zone_volume equal lx*ly*(77.8731010215422--122.126898978458)

compute                 O2_zone_temp O2_in_obs_zone temp

compute                 O2stress O2_in_obs_zone stress/atom O2_zone_temp
compute                 sum_stress O2_in_obs_zone reduce sum c_O2stress[1] c_O2stress[2] c_O2stress[3]
variable                O2pressure equal (-1)*(c_sum_stress[1]+c_sum_stress[2]+c_sum_stress[3])/(3*v_O2_obs_zone_volume)
#----------------------------------------------------------------------------------------------------------------------

#obervation group for O2
group                   obs_O2 dynamic O2_zone region obs_O2 every 1000
dynamic group obs_O2 defined
minimize                1e-6 1e-6 1000 10000 # shift atom locations to minimize the potential energy of the system. Helps if we accidentally introduce atoms that are overlapping and repel each other very strongly.
WARNING: Using a manybody potential with bonds/angles/dihedrals and special_bond exclusions (src/pair.cpp:251)
