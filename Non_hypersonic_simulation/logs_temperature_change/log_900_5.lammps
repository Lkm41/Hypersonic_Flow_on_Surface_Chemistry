velocity                all create ${T} ${seed} rot yes mom no
velocity                all create 900 ${seed} rot yes mom no
velocity                all create 900 20000 rot yes mom no
velocity                bottom set 0.0 0.0 0.
velocity                middle create ${T} ${seed} mom yes rot no dist gaussian
velocity                middle create 900 ${seed} mom yes rot no dist gaussian
velocity                middle create 900 20000 mom yes rot no dist gaussian

#variable                P equal ${P}
#fix                     integrator mobile npt temp ${T} ${T} 100 z 1.0 1.0 1000
#fix                     integrator mobile npt temp ${T} ${T} 100 x 1.0 1.0 1000 y 1.0 1.0 1000
#fix                      integrator mobile npt temp ${T} ${T} 100 x ${P} ${P} 1000 y ${P} ${P} 1000
fix                     integrator_O2 O2_zone nvt temp ${T} ${T} 100
fix                     integrator_O2 O2_zone nvt temp 900 ${T} 100
fix                     integrator_O2 O2_zone nvt temp 900 900 100

fix                     integrator_Ti upper nve
fix                     Ti_thermostat middle nvt temp ${T} ${T} 0.1
fix                     Ti_thermostat middle nvt temp 900 ${T} 0.1
fix                     Ti_thermostat middle nvt temp 900 900 0.1

fix                     zwalls all wall/reflect zlo EDGE zhi EDGE #reflective walls on the top and bottom surface to stop O2 molecules being lost

#----------------------------------------------------------------------------------------------------------------------

#count the number of atoms
variable                n_obs equal count(obs)

#measure the temperature of physisorption region
compute                 obsTemp obs temp

#measure temperature of Ti
compute                 obs_TiTemp obs_Ti temp

#measure temperature of O2
compute                 obs_O2Temp obs_O2 temp

#measure temperature of middle layer
compute                 T_middle middle temp

#____________________________________________________________________________________________________________________________

#outputs
thermo_style            custom step etotal ke pe density temp c_obsTemp c_obs_TiTemp c_T_middle c_obs_O2Temp press v_O2pressure v_n_obs # what to print
thermo                  1000 # print every 1000 timesteps

dump                    shock all custom 1000 ${output}/dumps/dump_${T}_${P}.lammpstrj id type x y z vx vy vz
dump                    shock all custom 1000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/dumps/dump_${T}_${P}.lammpstrj id type x y z vx vy vz
dump                    shock all custom 1000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/dumps/dump_900_${P}.lammpstrj id type x y z vx vy vz
dump                    shock all custom 1000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/dumps/dump_900_5.lammpstrj id type x y z vx vy vz

restart                 100000 ${output}/restarts_TiO2/restart_${T}_${P}.*
restart                 100000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/restarts_TiO2/restart_${T}_${P}.*
restart                 100000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/restarts_TiO2/restart_900_${P}.*
restart                 100000 /rds/user/lkm41/hpc-work/NoHS_xK_5bar/restarts_TiO2/restart_900_5.*

run                     1500000
