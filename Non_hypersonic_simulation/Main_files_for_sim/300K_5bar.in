clear

variable                output string /rds/user/lkm41/hpc-work/NoHS_xK_5bar

log                     ${output}/logs/log_${T}_${P}.lammps #to create mutiple log files

units                   metal
dimension               3
boundary                p p f
atom_style              full
#--------------------------------------------------------------------------------

# Variables
variable                Nsteps equal 100000
variable                dt equal 5.0
variable                seed equal 20000 #12345 # random number seed
#--------------------------------------------------------------------------------

# creating simulation box
read_data               data.Ti extra/bond/types 1 extra/bond/per/atom 2

#change_box all z final 0 ${Lz} units box #for only change in Lz
change_box              all x final 0 ${Lx} y final 0 ${Ly} z final 0 ${Lz} units box #for change in Lz, Lx, and Ly

timestep                0.001 #0.001 ps = 1x10−15 s = 1 femtosecond (1 fs)

neighbor                1.5 bin
#-----------------------------------------------------------------------------------

#defining Ti region
group                   titanium type 1

region                  Ti_zone block INF INF INF INF INF 16 units box
#changed from 8
region                  bottom block INF INF INF INF INF 4 units box #Ti bottom layer region

region                  middle block INF INF INF INF 4 8 units box #Ti middle layer

region                  upper block INF INF INF INF 8 16 units box #Ti upper layer region

#---------------------------------------------------------------------------------------------
#obseration regions
region                  obs_Ti block INF INF INF INF 8 16 units box #observation region - to observe temperature of moving Ti layer
#changed from 3 8

region                  obs block INF INF INF INF 16 19 units box #observation region - for physisorption effect
#changed from 8 11

region                  obs_O2 block INF INF INF INF 19 INF units box #observation region - for gas temperature
#changed from 11
#-------------------------------------------------------------------------------

#lennard-jones
pair_style              hybrid lj/cut 15.0 eam/fs #changed from 15 to 10

pair_coeff              * * eam/fs Ti1.eam.fs Ti NULL #Ti-Ti
pair_coeff              2 2 lj/cut 0.0044640704 3.00578 #O-O #taken from: https://pubs.aip.org/aip/jcp/article/142/23/234102/193620/Simplified-TiO2-force-fields-for-studies-of-its
pair_coeff              1 2 lj/cut 0.0105961 2.60289 #Ti-O #mixing lennard jones potential

# O2 Bonds
bond_style              harmonic
bond_coeff              1 847.0 1.21

special_bonds           lj 0.0 0.0 1.0

#creating atoms for Ti_zone
lattice                 hcp 2.95
create_atoms            1 region Ti_zone

#---------------------------------------------------------------------------------------
#Ti_zone groups
group                   bottom region bottom
group                   middle region middle
group                   upper region upper
#-------------------------------------------------------------------------------------

#creating O2 molecules
molecule                O2 O2.txt #made from given file

region                  gas block INF INF INF INF 19.0 ${Lz_minus_one} units box #gas region above  Ti slab


create_atoms            1 random ${N} ${seed} gas mol O2 ${seed} units box
group                   O2_zone region gas

group                   mobile subtract all bottom middle

fix                     freeze bottom setforce 0.0 0.0 0.0

fix                     balance all balance 5000 1.1 shift xyz 5 1.05

#obervation group for physisorption
group                   obs dynamic all region obs every 1000
#obervation group for titanium layer
group                   obs_Ti dynamic all region obs_Ti every 1000

#----------------------------------------------------------------------------------------------------------------------
#observation for pressure

variable                zhi equal ${Lz}
variable                zlo equal ${Lz}-200

region                  gas_obs_zone block INF INF INF INF ${zlo} ${zhi} units box

group                   O2_in_obs_zone dynamic all region gas_obs_zone every 100

variable                O2_obs_zone_volume equal lx*ly*(${zhi}-${zlo})

compute                 O2_zone_temp O2_in_obs_zone temp

compute                 O2stress O2_in_obs_zone stress/atom O2_zone_temp
compute                 sum_stress O2_in_obs_zone reduce sum c_O2stress[1] c_O2stress[2] c_O2stress[3]
variable                O2pressure equal (-1)*(c_sum_stress[1]+c_sum_stress[2]+c_sum_stress[3])/(3*v_O2_obs_zone_volume)
#----------------------------------------------------------------------------------------------------------------------

#obervation group for O2
group                   obs_O2 dynamic O2_zone region obs_O2 every 1000
minimize                1e-6 1e-6 1000 10000 # shift atom locations to minimize the potential energy of the system. Helps if we accidentally introduce atoms that are overlapping and repel each other very strongly.

velocity                all create ${T} ${seed} rot yes mom no
velocity                bottom set 0.0 0.0 0.
velocity                middle create ${T} ${seed} mom yes rot no dist gaussian

fix                     integrator_O2 O2_zone nvt temp ${T} ${T} 100

fix                     integrator_Ti upper nve
fix                     Ti_thermostat middle nvt temp ${T} ${T} 0.1

fix                     zwalls all wall/reflect zlo EDGE zhi EDGE #reflective walls on the top and bottom surface to stop O2 molecules being lost

#----------------------------------------------------------------------------------------------------------------------

#count the number of atoms
variable                n_obs equal count(obs)

#measure the temperature of physisorption region
compute                 obsTemp obs temp

#measure temperature of Ti
compute                 obs_TiTemp obs_Ti temp

#measure temperature of O2
compute                 obs_O2Temp obs_O2 temp

#measure temperature of middle layer
compute                 T_middle middle temp

#____________________________________________________________________________________________________________________________

#outputs
thermo_style            custom step etotal ke pe density temp c_obsTemp c_obs_TiTemp c_T_middle c_obs_O2Temp press v_O2pressure v_n_obs # what to print
thermo                  1000 # print every 1000 timesteps

dump                    shock all custom 1000 ${output}/dumps/dump_${T}_${P}.lammpstrj id type x y z vx vy vz

restart                 100000 ${output}/restarts_TiO2/restart_${T}_${P}.*

run                     1500000

print                   "simulation done."

#--------------------------------------------------------------------------------------------------------------------
