
units                   metal
dimension               3
boundary                p p p
atom_style              full

#--------------------------------------------------------------------------------

# Variables - let you make your input scripts dynamic instead of hard-coding numbers everywhere.
variable                Nsteps equal 100000
variable                dt equal 5.0
variable                seed equal 20000 #12345 # random number seed
#--------------------------------------------------------------------------------

# creating simulation box
read_data               data.Ti extra/bond/types 1 extra/bond/per/atom 2
Reading data file ...
  orthogonal box = (0 0 0) to (100 100 800)
  2 by 2 by 28 MPI processor grid
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        0       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.005 seconds
  read_data CPU = 0.040 seconds


#change_box all z final 0 ${Lz} units box #for only change in Lz
change_box              all x final 0 ${Lx} y final 0 ${Ly} z final 0 ${Lz} units box #for change in Lz, Lx, and Ly
change_box              all x final 0 2489.8 y final 0 ${Ly} z final 0 ${Lz} units box 
change_box              all x final 0 2489.8 y final 0 1088.55 z final 0 ${Lz} units box 
change_box              all x final 0 2489.8 y final 0 1088.55 z final 0 1090.2234143015905 units box 
Changing box ...
  orthogonal box = (0 0 0) to (2489.8 100 800)
  orthogonal box = (0 0 0) to (2489.8 1088.55 800)
  orthogonal box = (0 0 0) to (2489.8 1088.55 1090.2234)

timestep                0.0005 #0.5 fs

neighbor                1.5 bin #Which atoms are close enough to potentially interact? - include atoms up to 1.5 Å beyond the force cutoff in the neighbour list.

#---------------------------------------------------------------------------------------------

# Automated titanium regions

region                  Ti_zone block ${Lx_Ti_zone1} ${Lx_Ti_zone2} ${Ly_Ti_zone1} ${Ly_Ti_zone2} ${Lz_Ti_zone1} ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 ${Lx_Ti_zone2} ${Ly_Ti_zone1} ${Ly_Ti_zone2} ${Lz_Ti_zone1} ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 1253.969616344675 ${Ly_Ti_zone1} ${Ly_Ti_zone2} ${Lz_Ti_zone1} ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 1253.969616344675 233.61930306462654 ${Ly_Ti_zone2} ${Lz_Ti_zone1} ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 1253.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_zone1} ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 1253.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_zone2} units box
region                  Ti_zone block 1237.969616344675 1253.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box

region                  upper block ${Lx_Ti_upper1} ${Lx_Ti_upper2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 ${Lx_Ti_upper2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 1245.969616344675 ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 1245.969616344675 233.61930306462654 ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_upper2} units box
region                  upper block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box

region                  middle block ${Lx_Ti_middle1} ${Lx_Ti_middle2} ${Ly_Ti_middle1} ${Ly_Ti_middle2} ${Lz_Ti_middle1} ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 ${Lx_Ti_middle2} ${Ly_Ti_middle1} ${Ly_Ti_middle2} ${Lz_Ti_middle1} ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 1249.969616344675 ${Ly_Ti_middle1} ${Ly_Ti_middle2} ${Lz_Ti_middle1} ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 1249.969616344675 233.61930306462654 ${Ly_Ti_middle2} ${Lz_Ti_middle1} ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 1249.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_middle1} ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 1249.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_middle2} units box
region                  middle block 1245.969616344675 1249.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box

region                  bottom block ${Lx_Ti_bottom1} ${Lx_Ti_bottom2} ${Ly_Ti_bottom1} ${Ly_Ti_bottom2} ${Lz_Ti_bottom1} ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 ${Lx_Ti_bottom2} ${Ly_Ti_bottom1} ${Ly_Ti_bottom2} ${Lz_Ti_bottom1} ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 1253.969616344675 ${Ly_Ti_bottom1} ${Ly_Ti_bottom2} ${Lz_Ti_bottom1} ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 1253.969616344675 233.61930306462654 ${Ly_Ti_bottom2} ${Lz_Ti_bottom1} ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 1253.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_bottom1} ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 1253.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_bottom2} units box
region                  bottom block 1249.969616344675 1253.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box
#---------------------------------------------------------------------------------------------
#observation regions
region                  obs_Ti block ${Lx_Ti_upper1} ${Lx_Ti_upper2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box #observation region - to observe temperature of moving Ti layer
region                  obs_Ti block 1237.969616344675 ${Lx_Ti_upper2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs_Ti block 1237.969616344675 1245.969616344675 ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs_Ti block 1237.969616344675 1245.969616344675 233.61930306462654 ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs_Ti block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs_Ti block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_upper2} units box 
region                  obs_Ti block 1237.969616344675 1245.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box 

region                  obs block ${Lx_Ti_obs1} ${Lx_Ti_obs2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box #observation region - for physisorption effect
region                  obs block 1233.969616344675 ${Lx_Ti_obs2} ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs block 1233.969616344675 1237.969616344675 ${Ly_Ti_upper1} ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs block 1233.969616344675 1237.969616344675 233.61930306462654 ${Ly_Ti_upper2} ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs block 1233.969616344675 1237.969616344675 233.61930306462654 856.604111236964 ${Lz_Ti_upper1} ${Lz_Ti_upper2} units box 
region                  obs block 1233.969616344675 1237.969616344675 233.61930306462654 856.604111236964 233.61930306462654 ${Lz_Ti_upper2} units box 
region                  obs block 1233.969616344675 1237.969616344675 233.61930306462654 856.604111236964 233.61930306462654 856.604111236964 units box 

#---------------------------------------------------------------------------------------------------------------

#lennard-jones and eam
pair_style              hybrid lj/cut 15.0 eam/fs #changed from 15 to 10

pair_coeff              * * eam/fs Ti1.eam.fs Ti NULL #Ti-Ti
pair_coeff              2 2 lj/cut 0.0044640704 3.00578 #O-O #taken from: file://ifs.eng.cam.ac.uk/users/lkm41/Downloads/Short-Time_Oxidation_Behavior_of_Low-Carbon_Low-Si.pdf
pair_coeff              1 2 lj/cut 0.0105961 2.60289 #Ti-O #mixing lennard jones potential

# O2 Bonds
bond_style              harmonic #how bonded atoms interact - use a harmonic spring model for all bonds.
bond_coeff              1 847.0 1.21 #sets the numerical parameters for a bond type after you choose the bond model with bond_style

special_bonds           lj 0.0 0.0 1.0
Finding 1-2 1-3 1-4 neighbors ...
  special bond factors lj:    0        0        1       
  special bond factors coul:  0        0        0       
     0 = max # of 1-2 neighbors
     0 = max # of 1-3 neighbors
     0 = max # of 1-4 neighbors
     1 = max # of special neighbors
  special bonds CPU = 0.002 seconds

#creating atoms for Ti_zone
lattice                 hcp 2.95
Lattice spacing in x,y,z = 2.95 5.1095499 4.8173298
create_atoms            1 region Ti_zone
Created 347578 atoms
  using lattice units in orthogonal box = (0 0 0) to (2489.8 1088.55 1090.2234)
  create_atoms CPU = 0.006 seconds
#defining Ti region
group                   titanium type 1
347578 atoms in group titanium
#-------------------------------------------------------------------------------------
#Ti_zone groups
group                   bottom region bottom
94794 atoms in group bottom
group                   middle region middle
94794 atoms in group middle
group                   upper region upper
157990 atoms in group upper
#-------------------------------------------------------------------------------------

#creating O2 molecules
molecule                O2 O2.txt
Read molecule template O2:
# O2 molecule
  1 molecules
  0 fragments
  0 bodies
  2 atoms with max type 1
  1 bonds with max type 1
  0 angles with max type 0
  0 dihedrals with max type 0
  0 impropers with max type 0

#inlets and outlet regions

region                  inlet block 0 ${Lx_ten} 0 ${Ly} 0 ${Lz} units box
region                  inlet block 0 10 0 ${Ly} 0 ${Lz} units box
region                  inlet block 0 10 0 1088.55 0 ${Lz} units box
region                  inlet block 0 10 0 1088.55 0 1090.2234143015905 units box

create_atoms            1 random 1 ${seed} inlet mol O2 ${seed} units box
create_atoms            1 random 1 20000 inlet mol O2 ${seed} units box
create_atoms            1 random 1 20000 inlet mol O2 20000 units box
Created 2 atoms
  using box units in orthogonal box = (0 0 0) to (2489.8 1088.55 1090.2234)
  create_atoms CPU = 0.001 seconds

group                    O2_zone type 2
2 atoms in group O2_zone

# Define a dynamic group for injected O atoms
group                   injected dynamic O2_zone region inlet every 4
dynamic group injected defined

# Deposit O2 molecules into inlet region
fix                     injector O2_zone deposit 50000000 1 4 ${seed} mol O2 region inlet vx ${Vxmin} ${Vxmax} vy 0 0 vz 0 0 near 1.5 units box
fix                     injector O2_zone deposit 50000000 1 4 20000 mol O2 region inlet vx ${Vxmin} ${Vxmax} vy 0 0 vz 0 0 near 1.5 units box
fix                     injector O2_zone deposit 50000000 1 4 20000 mol O2 region inlet vx 15.829627285568035 ${Vxmax} vy 0 0 vz 0 0 near 1.5 units box
fix                     injector O2_zone deposit 50000000 1 4 20000 mol O2 region inlet vx 15.829627285568035 15.830627285568035 vy 0 0 vz 0 0 near 1.5 units box

#fix                     injector O2_zone deposit 100 0 4 ${seed} mol O2 region inlet vx ${Vxmin} ${Vxmax} vy 0 0 vz 0 0 near 1.5 units box
#---------------------------------------------------------------------------------------------------------
#obervation group for physisorption
group                   obs dynamic O2_zone region obs every 1000
dynamic group obs defined

#obervation group for titanium temp
group                   obs_Ti dynamic titanium region obs_Ti every 1000
dynamic group obs_Ti defined
#fix                     balance all balance 1000 1.2 rcb
#----------------------------------------------------------------------------------------------------
group                   mobile subtract all bottom middle
157992 atoms in group mobile

fix                     freeze bottom setforce 0.0 0.0 0.0
#----------------------------------------------------------------------------------------------------------------------
# Instantly thermalize injected molecules to temperature T
compute                 thermalizeO2_t injected temp/com
compute_modify          thermalizeO2_t dynamic/dof yes
fix                     thermalizeO2 injected temp/rescale 1 ${T} ${T} 0.0 1.0
fix                     thermalizeO2 injected temp/rescale 1 300 ${T} 0.0 1.0
fix                     thermalizeO2 injected temp/rescale 1 300 300 0.0 1.0
fix_modify              thermalizeO2 dynamic/dof yes temp thermalizeO2_t

unfix                   thermalizeO2

#----------------------------------------------------------------------------------------------------------------
#to observe temperature of system

region                  O2_temp_region block 50 100 0 ${Ly} 0 ${Lz} units box
region                  O2_temp_region block 50 100 0 1088.55 0 ${Lz} units box
region                  O2_temp_region block 50 100 0 1088.55 0 1090.2234143015905 units box

group                   O2_Tempcheck dynamic O2_zone region O2_temp_region every 100
dynamic group O2_Tempcheck defined

compute                 T_O2 O2_Tempcheck temp
compute                 T_O2_nonxh O2_Tempcheck temp/profile 1 0 0 x 1

#region                  outlet block  ${Lx_outlet} ${Lx} INF INF INF INF units box
variable                Lx_outlet1 equal (lx/2)+200
region                  outlet block ${Lx_outlet1} INF INF INF INF INF units box
region                  outlet block 1444.9 INF INF INF INF INF units box
#---------------------------------------------------------------------------------------------------------------

#-----------------------------------------------------------------------------------------------------------------
#obervation group for O2ls

minimize                1e-6 1e-6 1000 10000 # shift atom locations to minimize the potential energy of the system. Helps if we accidentally introduce atoms that are overlapping and repel each other very strongly.
