velocity                all create ${T} ${seed} rot yes mom no #sets or modifies atom velocities.
velocity                all create 300 ${seed} rot yes mom no 
velocity                all create 300 20000 rot yes mom no 
velocity                bottom set 0.0 0.0 0. #check with a one nve
velocity                middle create ${T} ${seed} mom yes rot no dist gaussian
velocity                middle create 300 ${seed} mom yes rot no dist gaussian
velocity                middle create 300 20000 mom yes rot no dist gaussian

fix                     integrator all nve
#----------------------------------------------------------------------------------------------------------------------

#count the number of atoms
variable                n_obs equal count(obs)

#measure the temperature of physisorption region
compute                 obsTemp obs temp

#measure temperature of Ti
compute                 obs_TiTemp obs_Ti temp

#measure the number at the outlet
group                   outlet_atoms dynamic O2_zone region outlet every 100
dynamic group outlet_atoms defined
variable                nout equal count(outlet_atoms)
#-----------------------------------------------------------------------------------------------------------------------

# Central 200 Å × 200 Å y-z sampling region for the 1D x-direction density and velocity profiles
region                  profile_region block INF INF 444.3 644.3 445.1 645.1 units box

# 1D bins along x
compute                 chunkx O2_zone chunk/atom bin/1d x lower 10.0 units box region profile_region

# 1D number density profile along x
fix                     densprof O2_zone ave/chunk 100 10 1000 chunkx density/number file ${output}/dat_files/density_profile.dat
fix                     densprof O2_zone ave/chunk 100 10 1000 chunkx density/number file /rds/user/lkm41/hpc-work/Hypersonic_TiO2/dat_files/density_profile.dat

# 1D mean x-velocity profile along x
fix                     vxprof O2_zone ave/chunk 100 10 1000 chunkx vx file ${output}/dat_files/vx_profile.dat
fix                     vxprof O2_zone ave/chunk 100 10 1000 chunkx vx file /rds/user/lkm41/hpc-work/Hypersonic_TiO2/dat_files/vx_profile.dat
#_______________________________________________________________________________________________________________________

#outputs
thermo_style            custom step etotal ke pe density temp press c_obsTemp c_obs_TiTemp v_n_obs c_T_O2 c_T_O2_nonxh v_nout # what to print

thermo                  1000 # print every 1000 timesteps

dump                    mydump all custom 1000 ${output}/dumps/dump_${T}_${P}.lammpstrj id type x y z vx vy vz
dump                    mydump all custom 1000 /rds/user/lkm41/hpc-work/Hypersonic_TiO2/dumps/dump_${T}_${P}.lammpstrj id type x y z vx vy vz
dump                    mydump all custom 1000 /rds/user/lkm41/hpc-work/Hypersonic_TiO2/dumps/dump_300_${P}.lammpstrj id type x y z vx vy vz
dump                    mydump all custom 1000 /rds/user/lkm41/hpc-work/Hypersonic_TiO2/dumps/dump_300_5.lammpstrj id type x y z vx vy vz

#---------------------------------------------------------------------------------------------------------------------
fix                     deleteatoms O2_zone evaporate 1 1000000000 outlet ${seed} molecule yes
fix                     deleteatoms O2_zone evaporate 1 1000000000 outlet 20000 molecule yes
#--------------------------------------------------------------------------------------------------------------------

restart                 100000 ${output}/restarts_TiO2/restart.*
restart                 100000 /rds/user/lkm41/hpc-work/Hypersonic_TiO2/restarts_TiO2/restart.*

run                     5000000
